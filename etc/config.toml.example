# brewcop machine / deployment config -- EXAMPLE
#
# Copy to /etc/brewcop/config.toml and fill in for this unit:
#   sudo install -m 0600 etc/config.toml.example /etc/brewcop/config.toml
#   sudo $EDITOR /etc/brewcop/config.toml
#
# This file holds install-time facts, read once at startup and never written
# at runtime -- so it is fine on the read-only root. It is DISTINCT from the
# touchscreen-editable user settings (pot tare/capacity, ...), which live in
# a writable JSON. There is no secret here: notification policy and any
# webhook secrets live in the downstream MQTT consumer, off this device.

# Serial device for the Avery Berkel scale.
#   "auto"                       -> autodetect (/dev/serial/by-id, /dev/ttyUSB*)
#   "/dev/serial/by-id/usb-..."  -> stable path (preferred for a fixed unit)
#   "/dev/ttyUSB0"               -> simple but can change across reboots
serial_port = "auto"

# MQTT broker that `ready` events publish to. brewcop is notification-
# agnostic: it just publishes to <mqtt_topic_prefix>/<location>/ready and a
# separate consumer decides what to do (Slack, signage, telemetry).
#   mqtt_host = ""   -> MQTT disabled; the app runs but publishes nothing
#   mqtt_host = "mqtt.example.org"  -> point at the mosquitto broker
mqtt_host = ""
mqtt_port = 1883
mqtt_topic_prefix = "brewcop"

# Deployment location, woven into the topic and event payload
# (e.g. topic "brewcop/B451/ready").
location = "B451"
