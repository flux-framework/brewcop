# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Build artifacts (pyproject/setuptools)
/build/
/dist/

# Debian packaging build artifacts (dpkg-buildpackage / pybuild).
# Keep the debian/ source files; ignore the generated tree.
/.pybuild/
/debian/.debhelper/
/debian/brewcop/
/debian/files
/debian/*.substvars
/debian/*.debhelper
/debian/*.debhelper.log
/debian/debhelper-build-stamp

# C build artifacts (test/Makefile)
*.o
/test/query

# Secrets / local machine config (ship etc/config.toml.example instead)
config.toml
brewcop-trace-*.csv

# Editor / OS
*.swp
.DS_Store
